---
import { leadershipItems } from "../../data/home";
---

<section class="section split leadership-section" id="leadership">
  <div>
    <p class="section-label">Leadership</p>
    <h2>More than ten years leading frontend work.</h2>
  </div>
  <div>
    <p class="leadership-intro">
      Since atmira, and later through SingularCover and Clikalia, my role
      has included tech lead responsibilities: setting technical direction,
      reviewing architecture, coordinating developers, mentoring engineers and
      turning early product ideas into work that can actually be built.
    </p>
    <ul class="leadership-list">
      {leadershipItems.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>
