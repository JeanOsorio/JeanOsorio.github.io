---
import { blogPosts } from "../../data/blog";
---

<section class="section blog-section" id="blog">
  <div class="section-heading">
    <p class="section-label">Blog</p>
    <h2>Writing queue: AI, frontend architecture and team leadership.</h2>
  </div>
  <div class="blog-list">
    {blogPosts.map((post) => (
      <article class="blog-card">
        <p class="card-tag">Article</p>
        <h3>{post.title}</h3>
        <p>{post.summary}</p>
        <a class="blog-link" href={`/blog/${post.slug}/`}>Read article</a>
        <ul class="chips">
          {post.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      </article>
    ))}
  </div>
</section>
