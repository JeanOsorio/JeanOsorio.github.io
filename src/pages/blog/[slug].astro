---
import SiteHeader from "../../components/common/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogPosts } from "../../data/blog";

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;

const articleNavLinks = [
  { href: "/#experience", label: "Experience" },
  { href: "/#ai", label: "AI" },
  { href: "/#leadership", label: "Leadership" },
  { href: "/blog/", label: "Blog" },
  { href: "/#contact", label: "Contact" }
];
---

<BaseLayout
  title={`${post.title} | Jean Osorio`}
  description={post.summary}
  canonical={Astro.site ? new URL(`/blog/${post.slug}/`, Astro.site).toString() : Astro.url.toString()}
>
  <SiteHeader links={articleNavLinks} />

  <main>
    <article class="section article-page">
      <p class="section-label">Article</p>
      <h1>{post.title}</h1>
      <p class="lede">{post.summary}</p>
      <ul class="chips article-tags">
        {post.tags.map((tag) => <li>{tag}</li>)}
      </ul>
      <div class="article-body">
        {post.content.map((paragraph) => <p>{paragraph}</p>)}
      </div>
      <a class="button" href="/blog/">Back to blog</a>
    </article>
  </main>
</BaseLayout>
