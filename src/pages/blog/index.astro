---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogPosts } from "../../data/blog";
---

<BaseLayout
  title="Jean Osorio Blog | AI, Frontend Architecture & Tech Leadership"
  description="Blog by Jean Osorio about AI-assisted delivery, frontend architecture and technical leadership."
>
  <header class="site-header">
    <a class="brand" href="/" aria-label="Home">JO</a>
    <nav class="nav" aria-label="Sections">
      <a href="/#experience">Experience</a>
      <a href="/#ai">AI</a>
      <a href="/#leadership">Leadership</a>
      <a href="/#projects">Projects</a>
      <a href="/#stack">Stack</a>
    </nav>
    <button class="theme-toggle" type="button" aria-label="Toggle dark mode" aria-pressed="false">
      <span class="theme-toggle__sun" aria-hidden="true">☀</span>
      <span class="theme-toggle__moon" aria-hidden="true">☾</span>
    </button>
  </header>

  <main>
    <section class="section blog-section page-hero">
      <p class="section-label">Blog</p>
      <h1>Blog</h1>
      <p class="lede">
        Notes about AI-assisted delivery, frontend architecture, technical
        leadership and the way product teams build better software.
      </p>
    </section>

    <section class="section blog-section">
      <div class="blog-list">
        {blogPosts.map((post) => (
          <article class="blog-card">
            <p class="card-tag">Article</p>
            <h2>{post.title}</h2>
            <p>{post.summary}</p>
            <a class="blog-link" href={`/blog/${post.slug}/`}>Read article</a>
            <ul class="chips">
              {post.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
