---
import SiteHeader from "../../components/common/SiteHeader.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogPosts } from "../../data/blog";

const blogNavLinks = [
  { href: "/#experience", label: "Experience" },
  { href: "/#ai", label: "AI" },
  { href: "/#leadership", label: "Leadership" },
  { href: "/#projects", label: "Projects" },
  { href: "/#stack", label: "Stack" }
];
---

<BaseLayout
  title="Jean Osorio Blog | AI, Frontend Architecture & Tech Leadership"
  description="Blog by Jean Osorio about AI-assisted delivery, frontend architecture and technical leadership."
>
  <SiteHeader links={blogNavLinks} />

  <main>
    <section class="section blog-section page-hero">
      <p class="section-label">Blog</p>
      <h1>Blog</h1>
      <p class="lede">
        Notes about AI-assisted delivery, frontend architecture, technical
        leadership and the way product teams build better software.
      </p>
    </section>

    <section class="section blog-section">
      <div class="blog-list">
        {blogPosts.map((post) => (
          <article class="blog-card">
            <p class="card-tag">Article</p>
            <h2>{post.title}</h2>
            <p>{post.summary}</p>
            <a class="blog-link" href={`/blog/${post.slug}/`}>Read article</a>
            <ul class="chips">
              {post.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
