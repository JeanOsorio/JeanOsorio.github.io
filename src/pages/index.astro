---
import SiteFooter from "../components/common/SiteFooter.astro";
import SiteHeader from "../components/common/SiteHeader.astro";
import AiSection from "../components/home/AiSection.astro";
import BlogPreviewSection from "../components/home/BlogPreviewSection.astro";
import ContactSection from "../components/home/ContactSection.astro";
import EducationSection from "../components/home/EducationSection.astro";
import ExperienceSection from "../components/home/ExperienceSection.astro";
import HeroSection from "../components/home/HeroSection.astro";
import LeadershipSection from "../components/home/LeadershipSection.astro";
import ProfileSection from "../components/home/ProfileSection.astro";
import ProjectsSection from "../components/home/ProjectsSection.astro";
import StackSection from "../components/home/StackSection.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const homeNavLinks = [
  { href: "#experience", label: "Experience" },
  { href: "#ai", label: "AI" },
  { href: "#leadership", label: "Leadership" },
  { href: "#projects", label: "Projects" },
  { href: "#blog", label: "Blog" },
  { href: "#stack", label: "Stack" },
  { href: "#contact", label: "Contact" }
];
---

<BaseLayout>
  <SiteHeader brandHref="#top" links={homeNavLinks} />

  <main id="top">
    <HeroSection />
    <ProfileSection />
    <AiSection />
    <LeadershipSection />
    <ExperienceSection />
    <ProjectsSection />
    <BlogPreviewSection />
    <StackSection />
    <EducationSection />
    <ContactSection />
  </main>

  <SiteFooter />
</BaseLayout>
